# Copy to .env and fill in the values you need. Every key is optional:
# features whose key is missing fall back to demo/mock responses or report
# that the integration is not configured.

# --- Server -----------------------------------------------------------------
# Port for `pnpm start` (production). `pnpm dev` always serves on 8080.
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins. Empty or "*" allows any origin.
CORS_ORIGIN=
# Maximum JSON request body size accepted by the API.
JSON_BODY_LIMIT=5mb
# Rate limit for POST/PUT/DELETE requests under /api (per client IP).
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
# Express "trust proxy" setting: true, false, a hop count or a subnet list.
# Defaults to 1 on Vercel/Netlify, otherwise false.
TRUST_PROXY=
# Response for GET /api/ping
PING_MESSAGE=ping

# --- AI providers -------------------------------------------------------------
# OpenRouter (Ask ICAS, outreach emails, content generation, alumni messages,
# delegate summaries, video scripts) - https://openrouter.ai/
OPENROUTER_API_KEY=
# Google Gemini (Smart Marketing image generation) - https://aistudio.google.com/
GOOGLE_API_KEY=
# Hugging Face (photo-to-video AI generation) - https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=
VIDEO_MODEL=stabilityai/stable-video-diffusion-img2vid-xt
# ElevenLabs (AI voice-over) - https://elevenlabs.io/
ELEVENLABS_API_KEY=
AUDIO_MODEL=
# Sarvam AI (speech-to-text for delegate session summaries) - https://www.sarvam.ai/
SARVAM_API_KEY=

# --- Search & outreach ------------------------------------------------------
# SerpAPI (web / LinkedIn search) - https://serpapi.com/
SERP_API_KEY=
# HubSpot private-app token (CRM) - https://developers.hubspot.com/
HUBSPOT_API_KEY=
# PhantomBuster (LinkedIn message automation) - https://phantombuster.com/
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_PHANTOM_ID=

# --- Uploads ------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# --- Firebase (client-side, exposed to the browser by Vite) ---------------------
# Firebase web config is public by design; protect data with Firebase
# security rules and restrict the API key to your domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
